generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NURSE
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String?
  role      Role       @default(NURSE)
  createdAt DateTime   @default(now())
  duties    DutyShift[]
}

model Nurse {
  email       String   @id @db.VarChar(254)
  firstName   String   @db.VarChar(120)
  lastName    String   @db.VarChar(120)
  nickname    String?  @db.VarChar(120)
  affiliation String?  @db.VarChar(255)
  colorId     String?  @db.VarChar(32)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DutyShift {
  id          String   @id @default(cuid())
  date        DateTime
  color       String
  firstName   String
  lastName    String
  nickname    String?
  affiliation String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([date, color])
  @@index([date])
}

// Temporary shared store for the legacy static frontend while its modules are
// migrated to typed API resources.
model LegacyStorage {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id                  String    @id @default(cuid())
  email               String
  firebaseUid         String
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  @@index([email, createdAt])
  @@index([resetTokenHash])
}
