generator client {
  provider = "prisma-client-js"
}

model Medicine {
  manualUsed  Int @default(0)
  dispensed   Int @default(0)
  borrowed    Int @default(0)
  active      Boolean @default(true)
  dispensations Dispensation[]
  loanItems LoanItem[]
  movements StockMovement[]
  id          String   @id @default(cuid())
  sequence    Int      @unique @default(autoincrement())
  code        String   @unique
  name        String   @db.VarChar(255)
  productName String?  @db.VarChar(255)
  genericName String?  @db.VarChar(255)
  category    String   @db.VarChar(16)
  form        String?  @db.VarChar(120)
  size        String?  @db.VarChar(120)
  unit        String?  @db.VarChar(120)
  benefit     String?  @db.Text
  symptom     String?  @db.Text
  usage       String?  @db.Text
  warning     String?  @db.Text
  total       Int      @default(0)
  used        Int      @default(0)
  expiry      DateTime? @db.Date
  imageData   Bytes?
  imageType   String?  @db.VarChar(32)
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NURSE
}

model User {
  id        String     @id @default(cuid())
  firebaseUid String? @unique
  active Boolean @default(true)
  email     String     @unique
  name      String
  password  String?
  role      Role       @default(NURSE)
  createdAt DateTime   @default(now())
  duties    DutyShift[]
}

model Nurse {
  email       String   @id @db.VarChar(254)
  firstName   String   @db.VarChar(120)
  lastName    String   @db.VarChar(120)
  nickname    String?  @db.VarChar(120)
  affiliation String?  @db.VarChar(255)
  colorId     String?  @db.VarChar(32)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DutyShift {
  id          String   @id @default(cuid())
  date        DateTime
  color       String
  firstName   String
  lastName    String
  nickname    String?
  affiliation String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([date, color])
  @@index([date])
}

// Temporary shared store for the legacy static frontend while its modules are
// migrated to typed API resources.
model LegacyStorage {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id                  String    @id @default(cuid())
  email               String
  firebaseUid         String
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  @@index([email, createdAt])
  @@index([resetTokenHash])
}

model InfirmaryVisit {
  dispensations Dispensation[]
  id            String   @id @default(cuid())
  visitorType   String   @db.VarChar(16)
  visitorDetail String?  @db.VarChar(160)
  firstName     String   @db.VarChar(120)
  lastName      String   @db.VarChar(120)
  nickname      String?  @db.VarChar(120)
  age           Int?
  studentId     String?  @db.VarChar(40)
  faculty       String?  @db.VarChar(32)
  branch        String?  @db.VarChar(255)
  gender        String?  @db.VarChar(16)
  blood         String?  @db.VarChar(3)
  weight        Float?
  height        Int?
  symptom       String   @db.Text
  sys           Int?
  dia           Int?
  pr            Int?
  status        String   @db.VarChar(16)
  hospitalName  String?  @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([studentId])
  @@index([status, createdAt])
}

model Dispensation {
  id String @id @default(cuid())
  visitId String
  visit InfirmaryVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  quantity Int
  name String
  code String
  unit String
  @@unique([visitId, medicineId])
}

model Loan {
  id String @id @default(cuid())
  details Json
  dueDate DateTime @db.Date
  createdAt DateTime @default(now())
  items LoanItem[]
  returns LoanReturn[]
}

model LoanItem {
  id String @id @default(cuid())
  loanId String
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Restrict)
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  quantity Int
  returned Int @default(0)
  name String
  code String
  unit String
  @@unique([loanId, medicineId])
}

model LoanReturn {
  id String @id @default(cuid())
  loanId String
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Restrict)
  items Json
  createdAt DateTime @default(now())
}

model StockMovement {
  id String @id @default(cuid())
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  source String
  sourceId String?
  reason String
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([medicineId, createdAt])
}

model InventoryRequest {
  id String @id
  fingerprint String
  result Json
  createdAt DateTime @default(now())
}

model CatalogOrder {
  id String @id
  sequence Int @unique @default(autoincrement())
  documentTitle String @db.VarChar(500)
  createdAt DateTime @default(now())
  deletedAt DateTime?
  items CatalogOrderItem[]
}

model CatalogOrderItem {
  id String @id @default(cuid())
  orderId String
  order CatalogOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  medicineId String?
  code String
  quantity Int
  snapshot Json
  @@unique([orderId, position])
}

model Faculty {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  name String @unique @db.VarChar(255)
  active Boolean @default(true)
  branches Branch[]
}

model Branch {
  id String @id @default(cuid())
  facultyId String
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  name String @db.VarChar(255)
  active Boolean @default(true)
  @@unique([facultyId, name])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  detail Json
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity, entityId])
}
