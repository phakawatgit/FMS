generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// เพิ่มตารางสำหรับเว็บ
model Nurse {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(255)
  lastName  String @db.VarChar(255)
  nickname  String @db.VarChar(255)
  TeleNumber String?

  @@map("Nurses")
}

model Patient {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(255)
  lastName  String @db.VarChar(255)
  nickname  String @db.VarChar(255)
  stuId     String @map("Stu.id") @db.Char(8)
}

model MedicineInventory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  productSku  String   @unique @map("Product SKU") @db.Char(8)
  productInfo String?  @map("Product Info") @db.VarChar(255)
  stock       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Medicine & Medical Supplies Inventory")
}