rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // FMS no longer accesses Firestore from the browser. Keep any existing
    // documents intact, but deny client access while records are migrated to
    // PostgreSQL and the old Firestore contents are reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
