{
  "name": "fms-platform",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "node --watch Back-end/src/server.js",
    "dev:stack": "docker compose up --build",
    "db:generate": "npm --prefix Back-end run prisma:generate",
    "db:migrate": "npm --prefix Back-end run prisma:migrate --"
  }
}
