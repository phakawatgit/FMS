  opacity: 0;
  visibility: hidden;
  transform: translate(-50%,4px);
  transition: opacity .12s ease,transform .12s ease;
}
.calendar-duty-dot:hover::after,.calendar-duty-dot:focus-visible::after {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%,0);
