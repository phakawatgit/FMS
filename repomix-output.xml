<file path="Front-end/menu.css">
:root {
  --navy: #08094b;
  --blue: #5d9bea;
  --blue-soft: #e4e9ff;
  --orange: #ffc39d;
  --ink: #121c4d;
  --muted: #69769b;
  --white: #fff;
}
* {
  box-sizing: border-box;
}
html {
  min-height: 100%;
}
body {
  min-height: 100svh;
  overflow-x: hidden;
  margin: 0;
  color: var(--ink);
  background: linear-gradient(145deg, #f0f2ff 0%, var(--blue-soft) 58%, #d8e0ff 100%);
  font-family: "IBM Plex Sans Thai", sans-serif;
}
button, input {
  font: inherit;
}
button {
  cursor: pointer;
}
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
