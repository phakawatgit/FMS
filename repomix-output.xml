<file path="Front-end/admin-settings.css">
:root {
  --deep-blue: #01406D;
  --teal: #01B4BA;
  --near-white: #F5FEFE;
  --orange: #FF7A0F;
  --muted: #527187;
  --surface: #F5FEFE;
}
* {
  box-sizing: border-box;
}
*, *::before, *::after {
  font-family: "Kanit", sans-serif !important;
}
body {
  min-height: 100vh;
  margin: 0;
  color: var(--deep-blue);
  background: var(--near-white);
  font-family: "Kanit", sans-serif;
}
.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 4.2rem;
  padding: .55rem clamp(1rem,4vw,3rem);
  background: var(--deep-blue);
  box-shadow: 0 .35rem 1.2rem rgba(1,64,109,.2);
}
.admin-brand {
  display: flex;
  align-items: center;
  gap: .7rem;
  color: #fff;
  font: 600 clamp(.9rem,2vw,1.2rem) "Kanit",sans-serif;
  text-decoration: none;
}
.admin-brand img {
  width: 2.8rem;
  border-radius: 22%;
}
.admin-topbar-actions {
  display: flex;
  align-items: center;
  gap: .45rem;
}
.admin-topbar button {
  cursor: pointer;
}
.back-menu-button {
  display: grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  border: 0;
  border-radius: .45rem;
  padding: 0;
  background: var(--near-white);
  color: var(--teal);
  transition: filter 160ms ease, transform 160ms ease;
}
.back-menu-button {
  display: grid;
}
.back-menu-button svg {
  width: 1.35rem;
  height: 1.35rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
}
.topbar-export {
  min-width: 2.55rem;
  height: 2.25rem;
  border: 0;
  border-radius: .45rem;
  padding: 0 .65rem;
  background: var(--near-white);
  color: var(--deep-blue);
  font: 600 .72rem "Kanit",sans-serif;
}
.topbar-bell {
  position: relative;
  display: grid;
  width: 1.7rem;
  height: 2.25rem;
  place-items: center;
  border: 0;
  padding: 0;
  background: transparent;
  color: var(--teal);
}
.topbar-bell svg {
  width: 1.2rem;
  height: 1.2rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.6;
}
.topbar-bell b,
.topbar-bell #notificationBadge {
  position: absolute;
  top: .05rem;
  right: -.15rem;
  display: grid;
  width: .82rem;
  height: .82rem;
  place-items: center;
  border-radius: 50%;
  background: #ef4545;
  color: #fff;
  font: 600 .48rem Arial,sans-serif;
}
.admin-notification-panel {
  position: absolute;
  z-index: 30;
  top: calc(100% + .55rem);
  right: 0;
  width: min(20rem, calc(100vw - 2rem));
  overflow: hidden;
  border: 1px solid #d6e8ee;
  border-radius: .8rem;
  background: #fff;
  box-shadow: 0 .6rem 1.6rem rgba(1,64,109,.2);
}
.admin-notification-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .8rem 1rem;
  border-bottom: 1px solid #edf1f7;
  color: var(--deep-blue);
}
.admin-notification-heading button {
  border: 0;
  padding: 0 .25rem;
  background: transparent;
  color: var(--muted);
  font-size: 1.25rem;
  line-height: 1;
}
.admin-notification-item {
  display: grid;
  grid-template-columns: .55rem 1fr;
  gap: .7rem;
  padding: .9rem 1rem;
  color: var(--deep-blue);
}
.admin-notification-item > span {
  width: .55rem;
  height: .55rem;
  margin-top: .35rem;
  border-radius: 50%;
  background: var(--teal);
}
.admin-notification-item strong { font-size: .82rem; }
.admin-notification-item p {
  margin: .18rem 0 0;
  color: var(--muted);
  font-size: .72rem;
  line-height: 1.4;
}
.admin-notification-empty {
  padding: 1rem;
  color: var(--muted);
  font-size: .75rem;
  text-align: center;
}
.admin-topbar-actions { position: relative; }
.topbar-language {
  min-width: 4.55rem;
  height: 2.25rem;
  border: 0;
  border-radius: .45rem;
  background: var(--near-white);
  color: var(--deep-blue);
  font: 600 .72rem "Kanit",sans-serif;
}
.back-menu-button:hover, .topbar-export:hover, .topbar-language:hover {
  filter: brightness(.94);
  transform: translateY(-1px);
}
.admin-page {
  width: min(72rem,calc(100% - 2rem));
  margin: 0 auto;
  padding: 2rem 0 4rem;
}
.settings-hero {
  padding: 1.8rem clamp(1.2rem,4vw,2.5rem);
  border: 1px solid #c6e9ea;
  border-radius: 1.3rem;
  background: var(--surface);
  box-shadow: 0 .8rem 2rem rgba(1,64,109,.12);
}
.eyebrow {
  margin: 0 0 .2rem;
  color: var(--orange);
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: .12em;
}
h1,h2 {
  font-family: "Kanit",sans-serif;
}
h1 {
  margin: .1rem 0 .3rem;
  color: var(--deep-blue);
  font-size: clamp(2rem,5vw,3rem);
}
.settings-hero p:last-child {
  margin: 0;
  color: var(--muted);
}
.settings-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1.2rem;
}
.admin-summary {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: .8rem;
  margin-top: 1.2rem;
}
.admin-summary article {
  display: flex;
  flex-direction: column;
  gap: .25rem;
  padding: 1rem 1.1rem;
  border: 1px solid #c6e9ea;
  border-radius: .9rem;
  background: var(--surface);
