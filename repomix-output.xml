  border: 1px solid #0b4568;
  border-radius: 8px;
  background: #0b4568;
  color: #fff;
  font-weight: 800;
  line-height: 1.4;
  box-shadow: 0 2px 5px #0b456826;
}
.purchase-day {
  border-color: #d0e0e7;
  background: #fff;
  color: #244a63;
  font-weight: 600;
  box-shadow: 0 1px 3px #123e5808;
}
.purchase-day.has-orders {
  border-color: #65b9b2;
  background: #fff;
