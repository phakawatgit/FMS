<link rel="stylesheet" href="./header-controls.css"><link rel="stylesheet" href="./button-animations.css?v=3"><link rel="stylesheet" href="./font-kanit.css?v=1"><link rel="stylesheet" href="./theme-colors.css?v=2"><link rel="stylesheet" href="./dashboard-refresh.css?v=15"><link rel="stylesheet" href="./dashboard-order-history.css?v=1"><link rel="stylesheet" href="./dashboard-order-calendar.css?v=1"><link rel="stylesheet" href="./dashboard-order-overview.css?v=1"><link rel="stylesheet" href="./dashboard-order-calendar-size.css?v=8"><link rel="stylesheet" href="./dashboard-topbar.css?v=1"><script src="./legacy-storage.js?v=2"></script></head>
<style>body .topbar .language-switcher::before,body .topbar .language-switcher::after,body .topbar .language-switcher span::before,body .topbar .language-switcher span::after{content:none!important;display:none!important}body .topbar .language-switcher>svg{display:block!important;width:16px!important;height:16px!important;fill:none!important;stroke:#08aeb8!important}</style>
<body>
  <header class="topbar dashboard-topbar">
    <a class="brand" href="./menu.html"><img src="./assets/fms.png" alt="FMS" /><span>First Aid &amp; Medicine Management System</span></a>
    <div class="top-actions"><a class="menu-link" href="./menu.html" aria-label="กลับไปหน้าเมนู" title="เมนู"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx=".7"/><rect x="14" y="3" width="7" height="7" rx=".7"/><rect x="3" y="14" width="7" height="7" rx=".7"/><rect x="14" y="14" width="7" height="7" rx=".7"/></svg></a><button id="exportExcel" class="export" type="button">Excel</button><button id="exportPdf" class="export" type="button">PDF</button><button id="notificationButton" class="icon-button" type="button" aria-label="Notifications"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7.2 23.3h17.6c-1.6-1.8-2.4-4-2.4-6.5v-3.1c0-3.7-2.4-6.5-6.4-7.2v-1c0-.9-.7-1.6-1.6-1.6s-1.6.7-1.6 1.6v1c-4 .7-6.4 3.5-6.4 7.2v3.1c0 2.5-.8 4.7-2.4 6.5h3.2Z"/><path d="M12.3 25.2c.5 1.2 1.5 1.8 2.7 1.8s2.2-.6 2.7-1.8"/></svg><span id="notificationBadge" class="notification-badge" hidden>0</span></button><button id="languageButton" class="language-switcher" type="button" aria-label="Change language"><span id="languageLabel">ไทย</span></button>
      <section id="notificationPanel" class="dashboard-notification" hidden><div class="dashboard-notification-head"><strong data-i18n="notifications">การแจ้งเตือน</strong><button id="markNotificationsRead" type="button" data-i18n="markRead">อ่านทั้งหมด</button></div><div id="notificationList"></div></section>
    </div>
  </header>
  <main class="page">
    <h1 data-i18n="overview">ภาพรวมแดชบอร์ด</h1>
    <section class="filter-card">
      <label><span data-i18n="dateRange">ช่วงวันที่</span><input id="startDate" type="date" aria-label="วันที่เริ่มต้น" /></label><span class="range-line" aria-hidden="true">ถึง</span><label class="date-end"><span data-i18n="dateTo">ถึงวันที่</span><input id="endDate" type="date" aria-label="วันที่สิ้นสุด" /></label><label><span data-i18n="faculty">หลักสูตร</span><select id="facultySelect"><option value="all">ทั้งหมด</option><option value="engineering">หลักสูตรวิศวกรรมศาสตร์</option><option value="agriculture">หลักสูตรเทคโนโลยีการเกษตรและวิทยาศาสตร์</option><option value="business">หลักสูตรบริหารธุรกิจและนวัตกรรม</option></select></label><label><span data-i18n="branch">สาขา</span><select id="branchInput"><option value="all">ทั้งหมด</option></select></label><button id="resetButton" type="button" data-i18n="reset">รีเซ็ต</button>
    </section>
    <section class="panel visits"><p class="panel-title" data-i18n="visitTrend">แนวโน้มการใช้บริการ</p><div class="bar-chart" aria-label="แนวโน้มการใช้บริการรายวัน"><span class="grid g1"></span><span class="grid g2"></span><span class="grid g3"></span><span class="grid g4"></span><div class="bars" aria-live="polite"></div></div></section>
