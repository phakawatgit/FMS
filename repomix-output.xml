<file path="Front-end/return-form.html">
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FMS | คืนยาและเวชภัณฑ์</title>
  <link rel="icon" href="./assets/fms.png">
  <link rel="stylesheet" href="./font-kanit.css?v=1">
  <link rel="stylesheet" href="./header-controls.css">
  <link rel="stylesheet" href="./theme-colors.css?v=3">
  <link rel="stylesheet" href="./return-form.css?v=8">
  <link rel="stylesheet" href="./dashboard-topbar.css?v=3">
<script src="./legacy-storage.js?v=2"></script></head>
<body>
  <header class="topbar dashboard-topbar">
    <a class="brand" href="./menu.html"><img src="./assets/fms.png" alt="FMS"><span>First Aid &amp; Medicine Management System</span></a>
    <div class="actions">
      <a class="menu-button" href="./menu.html" aria-label="กลับไปหน้าเมนู"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx=".7"/><rect x="14" y="3" width="7" height="7" rx=".7"/><rect x="3" y="14" width="7" height="7" rx=".7"/><rect x="14" y="14" width="7" height="7" rx=".7"/></svg></a>
      <button class="export" type="button">Excel</button><button class="export" type="button">PDF</button>
      <button class="bell" type="button" aria-label="การแจ้งเตือน"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 17h12l-1.4-2.2V10a4.6 4.6 0 0 0-9.2 0v4.8L6 17Zm4 2a2 2 0 0 0 4 0"/></svg></button>
      <button class="language" type="button"><i></i><span>ไทย</span></button>
    </div>
  </header>
  <main class="return-page">
    <a class="return-back" href="./borrow-return.html"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M13.5 8l-4 4 4 4M9.5 12h6"></path></svg><span>กลับหน้ารายการยืม-คืน</span></a>
    <h1>Medicine &amp; Medical Supplies<br><span>Borrowing &amp; Return</span></h1>
    <section class="return-sheet">
      <header class="return-sheet-heading"><h2>สัญญาการยืม</h2><span id="returnStatus" class="return-status"></span></header>
      <div id="returnBorrowerDetails" class="return-borrower-details"></div>
      <section class="return-products-section"><h2>ยา และเวชภัณฑ์ที่ยืม</h2><div id="borrowedProducts" class="return-products-list"></div></section>
      <section class="return-products-section to-return-section"><h2>ยา และเวชภัณฑ์ที่คืน</h2><p class="return-hint">กรอกจำนวนที่นำมาคืนในครั้งนี้</p><div id="returnProducts" class="return-products-list"></div></section>
      <p id="returnEmptyState" class="return-empty" hidden>ไม่พบรายการที่สามารถคืนได้</p>
    </section>
  </main>
  <footer class="return-footer"><div class="return-footer-inner"><button id="openReturnExport" class="return-export" type="button">Export</button><button id="cancelReturn" class="cancel-return" type="button">ยกเลิก</button><button id="submitReturn" class="submit-return" type="button">ส่งคืน</button></div></footer>
  <div id="returnExportModal" class="return-export-modal" hidden>
