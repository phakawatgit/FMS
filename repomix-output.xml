<file path="Back-end/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  NURSE
  STAFF
}

enum StockTransactionType {
  INTAKE
  ADJUSTMENT
  DISPENSATION
  BORROW
  RETURN
  WRITE_OFF
}

enum ReferralStatus {
  NOT_REQUIRED
  REFERRED
  COMPLETED
}

enum BorrowStatus {
  BORROWED
  RETURNED
  LATE
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FULL_DAY
  OTHER
}

enum AttendanceStatus {
  SCHEDULED
  PRESENT
  ABSENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @unique @map("employee_id") @db.VarChar(64)
  name         String   @db.VarChar(200)
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activityLogs      ActivityLog[]
  stockTransactions StockTransaction[]
  visits            Visit[]
  borrowRecords     BorrowRecord[]
  shiftAssignments  ShiftAssignment[]

  @@index([role])
  @@map("users")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(128)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items Item[]

  @@map("categories")
}

model Item {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  sku         String?  @unique @db.VarChar(80)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  unit        String   @db.VarChar(40)
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(12, 3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stockBatches      StockBatch[]
  stockTransactions StockTransaction[]
  borrowItems       BorrowItem[]

  @@index([categoryId, name])
  @@index([isActive, name])
  @@map("items")
}

model StockBatch {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  batchNumber     String    @map("batch_number") @db.VarChar(100)
  expiresAt       DateTime? @map("expires_at") @db.Date
  currentQuantity Decimal   @default(0) @map("current_quantity") @db.Decimal(12, 3)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  item            Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockTransactions StockTransaction[]
  dispensations   Dispensation[]

  @@unique([itemId, batchNumber])
  @@index([itemId, expiresAt])
  @@map("stock_batches")
}

model StockTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  itemId         String               @map("item_id") @db.Uuid
  stockBatchId   String               @map("stock_batch_id") @db.Uuid
  type           StockTransactionType
  quantity       Decimal              @db.Decimal(12, 3)
  note           String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  item      Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
  @@index([stockBatchId, createdAt])
  @@index([type, createdAt])
  @@map("stock_transactions")
}

model Patient {
  id           String   @id @default(uuid()) @db.Uuid
  patientNumber String?  @unique @map("patient_number") @db.VarChar(80)
  name         String   @db.VarChar(200)
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  phone        String?  @db.VarChar(40)
  email        String?  @db.VarChar(320)
  allergies    String?  @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  visits       Visit[]
  borrowRecords BorrowRecord[]

  @@index([name])
  @@map("patients")
}

model Visit {
  id             String         @id @default(uuid()) @db.Uuid
  patientId      String         @map("patient_id") @db.Uuid
  nurseId        String         @map("nurse_id") @db.Uuid
  visitedAt      DateTime       @default(now()) @map("visited_at") @db.Timestamptz(6)
  symptoms       String?        @db.Text
  diagnosis      String?        @db.Text
  treatmentNotes String?        @map("treatment_notes") @db.Text
  referralStatus ReferralStatus @default(NOT_REQUIRED) @map("referral_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  nurse         User           @relation(fields: [nurseId], references: [id], onDelete: Restrict)
  dispensations Dispensation[]

  @@index([patientId, visitedAt])
  @@index([nurseId, visitedAt])
  @@index([visitedAt])
  @@map("visits")
}

model Dispensation {
  id              String   @id @default(uuid()) @db.Uuid
  visitId         String   @map("visit_id") @db.Uuid
  stockBatchId    String   @map("stock_batch_id") @db.Uuid
  quantity        Decimal  @db.Decimal(12, 3)
  instructions    String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  visit      Visit      @relation(fields: [visitId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@unique([visitId, stockBatchId])
  @@index([stockBatchId, createdAt])
  @@map("dispensations")
}

model BorrowRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  processedById      String       @map("processed_by_id") @db.Uuid
  patientId          String       @map("patient_id") @db.Uuid
  borrowedAt         DateTime     @default(now()) @map("borrowed_at") @db.Timestamptz(6)
  expectedReturnAt   DateTime     @map("expected_return_at") @db.Timestamptz(6)
  actualReturnAt     DateTime?    @map("actual_return_at") @db.Timestamptz(6)
  status             BorrowStatus @default(BORROWED)
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  processedBy User         @relation(fields: [processedById], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items       BorrowItem[]

  @@index([processedById, borrowedAt])
  @@index([patientId, borrowedAt])
  @@index([status, expectedReturnAt])
  @@map("borrow_records")
}

model BorrowItem {
  id               String   @id @default(uuid()) @db.Uuid
  borrowRecordId   String   @map("borrow_record_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  quantityBorrowed Decimal  @map("quantity_borrowed") @db.Decimal(12, 3)
  quantityReturned Decimal  @default(0) @map("quantity_returned") @db.Decimal(12, 3)
  returnCondition  String?  @map("return_condition") @db.VarChar(100)
  returnedAt       DateTime? @map("returned_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  borrowRecord BorrowRecord @relation(fields: [borrowRecordId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([borrowRecordId, itemId])
  @@index([itemId, createdAt])
  @@map("borrow_items")
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  shiftType ShiftType @map("shift_type")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments ShiftAssignment[]

  @@index([date, shiftType])
  @@map("shifts")
}

model ShiftAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  shiftId            String           @map("shift_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  attendanceStatus   AttendanceStatus @default(SCHEDULED) @map("attendance_status")
  attendedAt         DateTime?        @map("attended_at") @db.Timestamptz(6)
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shiftId, userId])
  @@index([userId, attendanceStatus])
  @@map("shift_assignments")
}
