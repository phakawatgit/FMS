    <div class="two-col"><section class="panel status-panel"><p class="panel-title">สถานะสต็อกยา</p><div class="stock critical"><b>ยาหมดอายุแล้ว</b><small>0 รายการ</small><button class="stock-detail-button" type="button" data-medicine-status="expired" aria-label="ดูรายละเอียดยาหมดอายุ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div><div class="stock warning"><b>ใกล้หมดอายุ (ภายใน 30 วัน)</b><small>0 รายการ</small><button class="stock-detail-button" type="button" data-medicine-status="expiring" aria-label="ดูรายละเอียดยาใกล้หมดอายุ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div><div class="stock low"><b>ยาและเวชภัณฑ์ต่ำกว่า Min Stock</b><small>0 รายการ</small><button class="stock-detail-button" type="button" data-medicine-status="low" aria-label="ดูรายละเอียดยาใกล้หมดสต็อก"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div><div class="stock normal"><b>ยาและเวชภัณฑ์ปกติ</b><small>0 รายการ</small><button class="stock-detail-button" type="button" data-medicine-status="normal" aria-label="ดูรายละเอียดยาปกติ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div></section><section class="panel expiry"><p class="panel-title">ยาใกล้หมดอายุ</p><div id="expiryDonut" class="donut"><strong>0<small>รายการ</small></strong></div><ol class="expiry-legend"><li><span>หมดอายุแล้ว · 0</span></li><li><span>ภายใน 30 วัน · 0</span></li><li><span>1–3 เดือน · 0</span></li></ol></section></div>
    <div class="two-col"><section class="panel gender"><p class="panel-title">เปรียบเทียบเพศ</p><div class="gender-row"><div><span class="person male"><img src="./assets/gender-male.png" alt="ชาย" /></span><b>ชาย</b><strong id="maleCount">0</strong><small>Cases</small></div><div><span class="person female"><img src="./assets/gender-female.png" alt="หญิง" /></span><b>หญิง</b><strong id="femaleCount">0</strong><small>Cases</small></div></div><div class="gender-bars" aria-label="สัดส่วนผู้รับบริการตามเพศ"><div class="gender-track male-track"><i id="maleBar"></i></div><div class="gender-track female-track"><i id="femaleBar"></i></div></div></section><section class="panel referrals"><p class="panel-title">การส่งต่อโรงพยาบาล</p><div class="referral-main"><div class="hospital"><img src="./assets/hospital-referral.png" alt="โรงพยาบาล" /></div><strong id="referralCount">0<small>Cases</small></strong></div><p class="referral-heading">โรงพยาบาลที่เข้าบ่อยที่สุด 3 อันดับ</p><ol id="referralList" class="referral-list"></ol></section></div>
  </main>
  <dialog id="medicineDetailModal" class="medicine-modal"><button id="closeMedicineModal" class="medicine-modal-close" type="button" aria-label="ปิด">×</button><div class="medicine-picker-bar"><span id="medicinePageSummary"></span><div><button id="medicinePrevPage" type="button" aria-label="หน้าก่อนหน้า">‹</button><button id="medicineNextPage" type="button" aria-label="หน้าถัดไป">›</button></div></div><label class="medicine-picker-label">เลือกรายการยา<select id="medicinePicker"></select></label><div class="medicine-modal-head"><div id="medicineDetailImage" class="medicine-visual">💊</div><div><p id="medicineDetailStatus" class="medicine-status"></p><h2 id="medicineDetailName"></h2><p id="medicineDetailCode" class="medicine-code"></p></div></div><div id="medicineExpiryAlert" class="medicine-expiry"><span>วันหมดอายุ</span><strong id="medicineDetailExpiry"></strong><p id="medicineDetailAlert"></p></div><div class="medicine-stock-grid"><div><span>สต็อกทั้งหมด</span><strong id="medicineTotalStock"></strong></div><div><span>ใช้ไปแล้ว</span><strong id="medicineUsedStock"></strong></div><div><span>คงเหลือ</span><strong id="medicineRemainingStock"></strong></div></div></dialog>
  <footer></footer><script src="./dashboard.js?v=3"></script><script src="./notification-utils.js?v=1"></script><script src="./dashboard-live.js?v=1"></script><script src="./dashboard-order-history.js?v=9"></script>
