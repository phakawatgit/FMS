<file path="Front-end/infirmary-visit.html">
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FMS | Infirmary Visit</title>
  <link rel="icon" href="./assets/fms.png">
  <link rel="stylesheet" href="./infirmary-visit.css?v=23">
  <link rel="stylesheet" href="./header-controls.css">
  <link rel="stylesheet" href="./button-animations.css?v=3">
  <link rel="stylesheet" href="./font-kanit.css?v=1">
  <link rel="stylesheet" href="./theme-colors.css?v=2">
  <link rel="stylesheet" href="./dashboard-topbar.css?v=1">
  <link rel="stylesheet" href="./dashboard-refresh.css?v=14">
  <link rel="stylesheet" href="./infirmary-visit-faculty-branch.css?v=6">
<script src="./legacy-storage.js?v=2"></script></head>
<body>
  <header class="topbar dashboard-topbar">
    <a class="brand" href="./menu.html"><img src="./assets/fms.png" alt="FMS"><span>First Aid &amp; Medicine Management System</span></a>
    <div class="actions">
      <a class="menu-button" href="./menu.html" aria-label="กลับไปหน้าเมนู"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></a>
      <button class="export excel" type="button">Excel</button>
      <button class="export pdf" type="button">PDF</button>
      <button id="noticeButton" class="bell" type="button" aria-label="การแจ้งเตือน" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 17h12l-1.4-2.2V10a4.6 4.6 0 0 0-9.2 0v4.8L6 17Zm4 2a2 2 0 0 0 4 0"/></svg></button>
      <button id="languageButton" class="language" type="button"><i></i><span>ไทย</span></button>
    </div>
  </header>
  <main class="page">
    <a class="pending-link" href="./pending-assessment.html">รอประเมิน</a>
    <form id="visitForm" class="visit-form">
      <h2 data-i18n="formTitle">ฟอร์มการเข้าใช้ห้องพยาบาล</h2>
      <div class="visitor-type">
        <label class="visitor-option internal" data-type="student"><input class="visitor-check" type="checkbox" value="student"><i></i><span data-i18n="student">บุคลากรภายใน</span></label>
        <label class="visitor-option external" data-type="guest"><input class="visitor-check" type="checkbox" value="guest"><i></i><span data-i18n="guest">บุคลากรภายนอก</span></label>
        <input id="visitorDetail" class="visitor-detail" name="visitorDetail" disabled placeholder="เลือกประเภทบุคลากรก่อน">
      </div>
      <section class="form-grid">
        <label class="wide"><span data-i18n="firstName">ชื่อ</span><input name="firstName" required></label>
        <label class="wide"><span data-i18n="lastName">นามสกุล</span><input name="lastName" required></label>
        <label><span data-i18n="nickname">ชื่อเล่น</span><input name="nickname"></label>
        <label><span data-i18n="age">อายุ</span><input name="age" type="number" min="0" placeholder="ปี"></label>
        <label><span data-i18n="studentId">รหัสนักศึกษา</span><input name="studentId"></label>
        <label><span>หลักสูตร</span><select id="facultySelect" name="faculty"><option value="all">ทั้งหมด</option><option value="engineering">หลักสูตรวิศวกรรมศาสตร์</option><option value="agriculture">หลักสูตรเทคโนโลยีการเกษตรและวิทยาศาสตร์</option><option value="business">หลักสูตรบริหารธุรกิจและนวัตกรรม</option></select></label>
        <label><span data-i18n="branch">สาขา</span><select id="branchSelect" name="branch"><option value="all">ทั้งหมด</option></select></label>
        <label><span data-i18n="gender">เพศ</span><select name="gender"><option>เลือก</option><option>ชาย</option><option>หญิง</option></select></label>
        <label><span data-i18n="blood">กรุ๊ปเลือด</span><select name="blood"><option>เลือก</option><option>A</option><option>B</option><option>AB</option><option>O</option></select></label>
        <label><span data-i18n="weight">น้ำหนัก</span><input name="weight" type="number" min="0" placeholder="กก."></label>
        <label><span data-i18n="height">ส่วนสูง</span><input name="height" type="number" min="0" placeholder="ซม."></label>
        <label class="wide"><span data-i18n="symptom">อาการ</span><input name="symptom" placeholder="ระบุอาการ" required></label>
      </section>
      <section class="vitals">
        <div class="vitals-head"><span data-i18n="vitals">ผลการวัดความดัน</span></div>
        <div class="vital-inputs"><label>SYS<input name="sys" type="number" min="0" inputmode="numeric"></label><label>DIA<input name="dia" type="number" min="0" inputmode="numeric"></label><label>PR<input name="pr" type="number" min="0" inputmode="numeric"></label></div>
      </section>
      <section class="bottom-grid">
        <label><span data-i18n="medicine">ยาที่ได้รับ</span><select name="medicine"><option>เลือกยา</option><option>Paracetamol 500 mg</option><option>ORS</option><option>Cetirizine 10 mg</option></select></label>
        <label><span data-i18n="quantity">จำนวนยา /หน่วย</span><input name="quantity" type="number" min="0" placeholder="หน่วย"></label>
      </section>
      <fieldset class="status"><legend data-i18n="status">สถานะ</legend><label><input type="checkbox" name="status" value="normal"><i></i><span data-i18n="normal">ปกติ</span></label><label><input type="checkbox" name="status" value="observe"><i></i><span data-i18n="observe">รอดูอาการ</span></label><label><input type="checkbox" name="status" value="refer"><i></i><span data-i18n="refer">ส่งโรงพยาบาล</span></label></fieldset>
      <div id="referralHospitalField" class="referral-hospital" hidden><label><span>ชื่อโรงพยาบาลที่ส่งต่อ</span><input name="hospitalName" disabled placeholder="ระบุชื่อโรงพยาบาล"></label></div>
      <p id="formMessage" class="form-message" aria-live="polite"></p>
      <div class="form-actions"><button id="cancelButton" class="cancel" type="reset" data-i18n="cancel">ยกเลิก</button><button class="save" type="submit" data-i18n="save">บันทึก</button></div>
    </form>
  </main>
  <aside id="notificationPanel" class="notification-panel" hidden><button id="closeNotifications" type="button" aria-label="ปิด">×</button><strong>การแจ้งเตือน</strong><p>มีรายการรอดำเนินการ 6 รายการ</p></aside>
  <script src="./infirmary-visit.js?v=6"></script>
  <script src="./infirmary-visit-branch-lock.js?v=1"></script>
  <script src="./infirmary-visit-faculty-branch.js?v=2"></script>
<script src="./language-toggle.js?v=13"></script><script src="./header-controls.js?v=4"></script></body>
</html>
</file>

<file path="Front-end/menu.html">
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FMS | Menu</title>
    <link rel="icon" type="image/png" href="./assets/fms.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Itim&family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="./menu.css?v=22" />
<link rel="stylesheet" href="./header-controls.css"><link rel="stylesheet" href="./button-animations.css?v=3"><link rel="stylesheet" href="./font-kanit.css?v=1"><link rel="stylesheet" href="./theme-colors.css?v=3"><script src="./legacy-storage.js?v=2"></script></head>

<body>
    <header class="topbar">
        <div class="container-fluid topbar-inner">
            <a class="brand" href="./menu.html" aria-label="FMS home">
                <img src="./assets/fms.png" alt="" />
                <span>First Aid &amp; Medicine Management System</span>
            </a>
            <div class="topbar-actions">
                <button id="notificationButton" class="icon-button" type="button" aria-label="การแจ้งเตือน" data-i18n-aria-label="notifications">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M7.2 23.3h17.6c-1.6-1.8-2.4-4-2.4-6.5v-3.1c0-3.7-2.4-6.5-6.4-7.2v-1c0-.9-.7-1.6-1.6-1.6s-1.6.7-1.6 1.6v1c-4 .7-6.4 3.5-6.4 7.2v3.1c0 2.5-.8 4.7-2.4 6.5h3.2Z" />
              <path d="M12.3 25.2c.5 1.2 1.5 1.8 2.7 1.8s2.2-.6 2.7-1.8" />
            </svg>
            <span id="notificationBadge" class="notification-badge" hidden>0</span>
          </button>
                <section id="notificationPanel" class="notification-panel" hidden aria-label="การแจ้งเตือน" data-i18n-aria-label="notifications">
                    <div class="notification-panel-header">
                        <div>
                            <p data-i18n="notifications">การแจ้งเตือน</p>
                            <span id="notificationSummary">รายการที่ต้องดำเนินการ</span>
                        </div>
                        <button id="markNotificationsRead" type="button" data-i18n="markAllRead">อ่านทั้งหมด</button>
                    </div>
                    <div id="notificationList" class="notification-list"></div>
                </section>
                <fieldset class="language-switcher" aria-label="เปลี่ยนภาษา" data-i18n-aria-label="changeLanguage">
                    
                    <label><input type="radio" name="language" value="en" /> <span>English</span></label>
                    <label><input type="radio" name="language" value="th" checked /> <span>ไทย</span></label>
                </fieldset>
                <button id="signOutButton" class="sign-out" type="button">
            <span id="signOutLabel">ออกจากระบบ</span>
            <img class="sign-out-icon" src="./assets/logout-icon.png" alt="" />
          </button>
            </div>
        </div>
    </header>

    <main class="container-fluid page-content">
        <section class="overview-card" aria-labelledby="calendarTitle">
            <div class="calendar-area">
                <div class="section-heading">
                    <div>
                        <h1 id="calendarTitle" data-i18n="dutyShift">การเข้าเวร</h1>
                        <h2 id="monthTitle"></h2>
                    </div>
                    <button id="viewCalendarButton" class="small-action" type="button" data-i18n="viewCalendar">ดูปฏิทิน</button>
                </div>
                <div class="week-row" aria-hidden="true">
                    <span data-i18n="sun">อา</span><span data-i18n="mon">จ</span><span data-i18n="tue">อ</span><span data-i18n="wed">พ</span><span data-i18n="thu">พฤ</span><span data-i18n="fri">ศ</span><span data-i18n="sat">ส</span>
                </div>
                <div id="calendarGrid" class="calendar-grid" aria-label="ปฏิทินเดือนสิงหาคม 2026" data-i18n-aria-label="calendarLabel"></div>
            </div>
            <aside class="duty-tools">
                <section class="color-picker-card" aria-labelledby="colorPickerTitle">
                    <div class="color-picker-head">
                        <strong id="colorPickerTitle" data-i18n="chooseColor">เลือกแถบสี</strong>
                    </div>
                    <div class="color-carousel">
                        <button id="previousColorPage" class="color-nav" type="button" aria-label="สีหน้าก่อนหน้า" data-i18n-aria-label="previousColorPage">&#x2039;</button>
                        <div id="colorPalette" class="color-palette" role="group" aria-label="เลือกสีประจำตัว" data-i18n-aria-label="choosePersonalColor"></div>
                        <button id="nextColorPage" class="color-nav" type="button" aria-label="สีหน้าถัดไป" data-i18n-aria-label="nextColorPage">&#x203A;</button>
                    </div>
                    <div id="colorPagination" class="color-pagination" role="tablist" aria-label="หน้าของสี"></div>
                </section>
                <section class="duty-form-card" aria-labelledby="dutyFormTitle">
                    <h3 id="dutyFormTitle" data-i18n="dutyRecord">บันทึกการเข้าเวร</h3>
                    <p class="duty-form-hint" data-i18n="dutyHint">กรอกข้อมูลให้ครบเพื่อบันทึกเวรของคุณ</p>
                    <form id="dutyForm">
                        <div class="duty-form-grid">
                            <label><span data-i18n="firstName">ชื่อ</span><input id="nurseFirstName" type="text" placeholder="เช่น สมใจ" data-i18n-placeholder="firstNamePlaceholder" required /></label>
                            <label><span data-i18n="lastName">นามสกุล</span><input id="nurseLastName" type="text" placeholder="เช่น ใจดี" data-i18n-placeholder="lastNamePlaceholder" required /></label>
                            <label><span data-i18n="nickname">ชื่อเล่น</span><input id="nurseNickname" type="text" placeholder="ไม่บังคับ" data-i18n-placeholder="nicknamePlaceholder" /></label>
                            <label><span data-i18n="affiliation">สังกัด</span><input id="nurseAffiliation" type="text" placeholder="เช่น ห้องพยาบาล" data-i18n-placeholder="affiliationPlaceholder" /></label>
                        </div>
                        <p id="dutyStatus" class="duty-status" aria-live="polite"></p>
                        <button class="schedule-button" type="submit" data-i18n="saveDuty">บันทึก</button>
                    </form>
                </section>
            </aside>
        </section>

        <section id="yearCalendarModal" class="year-calendar-modal" hidden aria-labelledby="yearCalendarTitle" role="dialog" aria-modal="true">
            <div class="year-calendar-backdrop" data-close-calendar></div>
            <div class="year-calendar-dialog">
                <div class="year-calendar-header">
                    <div>
                    <p class="eyebrow" data-i18n="dutyOverview">ภาพรวมการเข้าเวร</p>
                        <h2 id="yearCalendarTitle" data-i18n="yearCalendarTitle">ปฏิทินเวรประจำปี</h2>
                        <p class="year-calendar-legend"><span></span> <span data-i18n="yearCalendarLegend">จุดสีแสดงวันที่มีพยาบาลเข้าเวร</span></p>
                    </div>
                    <button id="closeYearCalendar" class="close-calendar" type="button" aria-label="ปิดปฏิทิน" data-i18n-aria-label="closeCalendar">×</button>
                </div>
                <div class="year-calendar-toolbar">
                    <span class="year-calendar-label" data-i18n="selectYear">เลือกปี</span>
                    <div class="year-calendar-picker" id="yearCalendarPicker">
                        <button id="yearCalendarPrevious" class="year-calendar-chevron" type="button" aria-label="ปีก่อนหน้า" data-i18n-aria-label="previousYear">‹</button>
                        <button id="yearCalendarTrigger" class="year-calendar-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                            <span id="yearCalendarValue"></span>
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg>
                        </button>
                        <button id="yearCalendarNext" class="year-calendar-chevron" type="button" aria-label="ปีถัดไป" data-i18n-aria-label="nextYear">›</button>
                        <div id="yearCalendarOptions" class="year-calendar-options" role="listbox" aria-label="เลือกปี" data-i18n-aria-label="selectYear" hidden></div>
                    </div>
                </div>
                <div id="yearCalendarContent" class="year-calendar-content"></div>
            </div>
        </section>

        <section class="menu-section" aria-labelledby="menuTitle">
            <div class="menu-heading">
                <div>
                    <p class="eyebrow" data-i18n="workspace">พื้นที่ทำงาน</p>
                    <h2 id="menuTitle" data-i18n="menu">เมนู</h2>
                </div>
