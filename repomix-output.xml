:root {
  color-scheme: light;
  --navy: #073f70;
  --blue: #3568df;
  --teal: #00aaa9;
  --line: #c7e9ed;
  --ink: #112d48;
  --muted: #647b91;
  --page: #e8eaff;
  --surface: #fff;
  --shadow: 0 5px 16px #163b6517;
  font-family: "Kanit",Arial,sans-serif;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--page);
  color: var(--ink);
  font-family: "Kanit",Arial,sans-serif;
  font-size: 15px;
}
.topbar {
  height: 56px;
  background: #09053f;
  border-bottom: 5px solid #07517e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 14px;
  gap: 14px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
  text-decoration: none;
  font-size: 16px;
  font-weight: 600;
  white-space: nowrap;
}
.brand img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}
.actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.actions button,.actions a {
  font: inherit;
}
.menu-button,.export,.bell,.language {
  height: 34px;
  border: 1px solid #b7dfe7;
  background: #fff;
  color: #174e75;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 9px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}
.topbar .menu-button {
  color: #174e75!important;
}
.menu-button svg,.language svg,.bell svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
}
.bell {
  position: relative;
  width: 38px;
  background: #fff5ce;
  border-color: #ffcf54;
}
.bell b {
  position: absolute;
  right: -3px;
  top: -6px;
  border-radius: 50%;
  background: #ed455b;
  color: #fff;
  font-size: 9px;
  width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
}
.language {
  background: #e9f7ff;
  border-color: #a8d9f6;
}
.duty-page {
  width: min(100% - 28px,1100px);
  margin: 0 auto;
  padding: 15px 0 36px;
}
.duty-page-heading {
  border-bottom: 1px solid #cbdde8;
  padding: 0 6px 12px;
  margin-bottom: 14px;
}
.duty-page-heading h1 {
  margin: 0;
  color: #0d2b4a;
  font-size: 21px;
  line-height: 1.35;
  font-weight: 700;
}
.mobile-break {
  display: none;
}
.calendar-panel,.recent-panel {
  background: var(--surface);
  border: 1px solid #c9e4ec;
  border-radius: 16px;
  box-shadow: var(--shadow);
  padding: 16px;
  margin-bottom: 14px;
}
.calendar-title-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.calendar-title-row h2 {
  margin: 0;
  font-size: 22px;
  line-height: 1.2;
  color: #0b2b4b;
}
.month-picker {
  grid-column: 2;
  justify-self: center;
}
.month-picker select {
  min-width: 176px;
  max-width: 100%;
  height: 40px;
  border: 1px solid #c4e7ed;
  border-radius: 9px;
  background: #e8f7f8;
  color: #124576;
  padding: 0 12px;
  font: 600 17px "Kanit",Arial,sans-serif;
  cursor: pointer;
  outline: none;
}
.month-picker select:focus,.duty-form-card input:focus,.record-search:focus-within {
  border-color: #3e70df;
  box-shadow: 0 0 0 3px #3568df20;
}
.week-row,.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7,minmax(0,1fr));
  gap: 5px;
}
.week-row {
  margin-bottom: 5px;
}
.week-row span {
  height: 34px;
  border-radius: 6px;
  background: #074a7b;
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 12px;
}
.calendar-grid {
  grid-auto-rows: minmax(48px,1fr);
}
.calendar-cell,.calendar-blank {
  min-width: 0;
  min-height: 48px;
}
.calendar-cell {
  position: relative;
  border: 1px solid #d2e8ed;
  border-radius: 5px;
  background: #fff;
  color: #17405f;
  text-align: right;
  padding: 4px 6px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  font: 500 12px "Kanit",Arial,sans-serif;
  cursor: pointer;
  transition: border-color .15s,background .15s,transform .15s;
}
.calendar-cell:hover {
  border-color: #5299cf;
  background: #f2faff;
  transform: translateY(-1px);
}
.calendar-cell.is-today {
  box-shadow: inset 0 0 0 1px #00a9ad;
}
.calendar-cell.is-selected {
  background: #e7f4ff;
  border-color: #3568df;
}
.calendar-dots {
  display: flex;
  gap: 3px;
  align-self: flex-start;
}
.calendar-duty-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}
.duty-tools {
  display: grid;
  grid-template-columns: minmax(220px,.9fr) minmax(320px,1fr);
  gap: 14px;
  margin-top: 13px;
}
.color-picker-card,.duty-form-card {
  border: 1px solid #7f3be9;
  border-radius: 12px;
  padding: 10px 12px;
  background: #fff;
}
.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #19466b;
  font-size: 14px;
  margin-bottom: 8px;
}
.color-picker-head>span {
  width: 24px;
  height: 24px;
  border: 1px solid #b9cfda;
  border-radius: 7px;
}
.color-carousel {
  display: flex;
  align-items: center;
  gap: 6px;
}
.color-nav {
  width: 26px;
  height: 28px;
  flex: none;
  border: 1px solid #d5e3ea;
  border-radius: 6px;
  background: #f4f9fb;
  color: #255878;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}
.color-nav:disabled {
  opacity: .4;
  cursor: default;
}
.color-palette {
  display: grid;
  grid-template-columns: repeat(10,minmax(12px,1fr));
  gap: 5px;
  flex: 1;
}
.color-choice {
  height: 19px;
  min-width: 0;
  border: 1px solid #ffffff;
  border-radius: 5px;
  box-shadow: 0 0 0 1px #d5e0e6;
  cursor: pointer;
}
.color-choice.is-selected {
  box-shadow: 0 0 0 2px #135b99;
  transform: scale(1.08);
}
.color-choice.is-locked {
  opacity: .25;
  cursor: not-allowed;
}
.color-pagination {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-top: 8px;
}
.color-page-dot {
  width: 8px;
  height: 8px;
  border: 0;
  border-radius: 50%;
  background: #c5d3dc;
  padding: 0;
  cursor: pointer;
}
.color-page-dot.is-active {
  width: 19px;
  border-radius: 6px;
  background: #376bdd;
}
.duty-form-card {
  border-color: #4f72dd;
}
.duty-form-card h3 {
  margin: 0 0 7px;
  color: #123d67;
  font-size: 15px;
}
.duty-form-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 8px;
}
.duty-form-grid label {
  display: grid;
  gap: 3px;
  color: #526b7c;
  font-size: 12px;
}
.duty-form-grid input {
  height: 32px;
  width: 100%;
  border: 1px solid #d0e1e8;
  border-radius: 7px;
  background: #f9fcfd;
  padding: 4px 8px;
  color: #17354e;
  font: 14px "Kanit",Arial,sans-serif;
  outline: 0;
}
.selected-date-label {
  margin: 7px 0 0;
  color: #637b8c;
  font-size: 12px;
}
.selected-date-label strong {
  color: #174975;
}
.duty-form-footer {
  display: flex;
