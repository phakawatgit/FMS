}
.return-download-badge {
  position: absolute;
  right: -.05rem;
  bottom: -.05rem;
  display: grid;
  width: 1.8rem;
  height: 1.8rem;
  place-items: center;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #ff7417;
  box-shadow: 0 .15rem .35rem rgba(168,77,10,.18);
