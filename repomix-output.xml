  background: transparent;
  color: #143b58;
  font: 14px "Kanit",Arial,sans-serif;
}
.record-search input::placeholder {
  color: #8a9aa8;
}
.record-search>span {
  font-size: 21px;
  line-height: 1;
}
.recent-list-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #e5eef2;
  padding: 0 2px 7px;
  margin-bottom: 9px;
}
.recent-list-heading h3 {
  margin: 0;
  color: #17446b;
  font-size: 16px;
}
.recent-list-heading>span {
  display: grid;
  place-items: center;
  min-width: 24px;
  height: 23px;
  padding: 0 6px;
  border-radius: 12px;
  background: #e9f5fb;
  color: #28618a;
  font-size: 12px;
}
.duty-record-list {
  display: grid;
  gap: 8px;
}
.duty-record-card {
  display: grid;
  grid-template-columns: minmax(108px,155px) 1fr;
  gap: 14px;
  align-items: center;
  padding: 12px 14px;
  border: 1px solid #f1d5ce;
  border-left: 4px solid var(--teal);
  border-radius: 11px;
  background: #fff;
  box-shadow: 0 2px 7px #253e5c0c;
}
.duty-record-card time {
  font-size: 14px;
  font-weight: 600;
  color: #19476e;
}
.duty-record-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.duty-record-person {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  color: #244763;
}
.duty-record-person i {
  width: 14px;
  height: 14px;
  flex: none;
  border-radius: 50%;
  box-shadow: 0 0 0 3px #edf4f8;
}
.duty-record-person>span {
  overflow-wrap: anywhere;
}
.duty-record-person strong {
  font-weight: 600;
}
.duty-record-time {
  white-space: nowrap;
  color: #647c8e;
  font-size: 12px;
}
.empty-records,.duty-record-empty {
  margin: 0;
  padding: 22px 10px;
  text-align: center;
  color: #71889a;
  background: #f7fbfd;
  border: 1px dashed #d3e5ec;
  border-radius: 10px;
}
.notification-panel {
  position: fixed;
  z-index: 10;
  right: 14px;
  top: 64px;
  width: min(320px,calc(100vw - 28px));
  padding: 16px;
  border: 1px solid #c7e3eb;
  border-radius: 12px;
  background: white;
  box-shadow: 0 10px 30px #0a274331;
  color: #234762;
}
.notification-panel[hidden] {
  display: none;
}
.notification-panel strong {
  display: block;
  padding-right: 22px;
  color: #123d65;
}
.notification-panel p {
  margin: 7px 0 0;
  font-size: 13px;
  color: #60778a;
}
.notification-panel button {
  position: absolute;
  right: 8px;
  top: 7px;
  border: 0;
  background: transparent;
  font-size: 22px;
  color: #627c8f;
  cursor: pointer;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
