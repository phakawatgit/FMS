<file path="Front-end/dashboard-order-calendar-size.css">
/* Make the monthly purchase calendar use the full history panel width. */
#purchaseCalendarContent {
  display: block;
  width: 100%;
  min-width: 0;
}
.purchase-calendar {
  box-sizing: border-box;
  width: 100%;
  max-width: 1120px;
  margin: 0 auto 20px;
  padding: 14px;
}
.purchase-calendar-toolbar {
  grid-template-columns: 36px minmax(0, 1fr) 36px;
  gap: 10px;
  margin-bottom: 10px;
}
.purchase-calendar-toolbar strong {
  font-size: 1.04rem;
}
.purchase-calendar-toolbar button {
  width: 34px;
  height: 34px;
}
.purchase-calendar-week, .purchase-calendar-grid {
  gap: 5px;
}
.purchase-calendar-week span {
  padding: 6px 0;
  font-size: 0.82rem;
}
.purchase-day, .purchase-day-blank {
  min-height: clamp(48px, 4vw, 58px);
}
.purchase-day {
  gap: 4px;
  border-radius: 8px;
  font-size: 0.84rem;
}
.purchase-day-dots {
  gap: 4px;
  min-height: 8px;
}
.purchase-dot {
  width: 7px;
  height: 7px;
}
.purchase-day-dots small {
  font-size: 0.7rem;
}

/* Stronger contrast and clearer interactive states. */
.purchase-calendar {
  border-color: #c4d9e2;
  background: #f4f9fc;
  box-shadow: 0 8px 24px #123e5814;
}
.purchase-calendar-toolbar strong {
  color: #073b62;
  font-weight: 800;
}
