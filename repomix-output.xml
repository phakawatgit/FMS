<file path="Front-end/style.css">
@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Itim&family=Kanit:wght@400;500;600;700&family=Nerko+One&display=swap");
* {
  box-sizing: border-box;
}
:root {
  color-scheme: light;
  --blue: #4c95e8;
  --blue-deep: #12376e;
  --blue-pale: #eff7ff;
  --orange: #f4773b;
  --orange-pale: #fff0e7;
  --ink: #16345f;
  --muted: #7d8ca1;
  --white: #ffffff;
  --line: #dce7f3;
}
html, body {
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: hidden;
}
body {
  margin: 0;
  font-family: "IBM Plex Sans Thai", sans-serif;
  color: var(--ink);
  background: var(--blue-pale);
}
button, input {
  font: inherit;
}
h1, h2, button, .fms-brand, .brand-label {
  font-family: "Kanit", "IBM Plex Sans Thai", sans-serif;
}
button {
  cursor: pointer;
}
.site-shell {
  width: 100%;
  height: 100vh;
  height: 100svh;
  min-height: 100vh;
  min-height: 100svh;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
  background: var(--white);
  overflow: hidden;
}
.brand-panel {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  padding: clamp(2rem, 5vw, 5rem);
  background: radial-gradient(circle at 7% 8%, rgba(255, 255, 255, 0.27) 0 9%, transparent 9.2%),     linear-gradient(145deg, #62c8eb 0%, var(--blue) 68%, #3475d1 100%);
}
.brand-panel::before, .brand-panel::after {
  content: "";
  position: absolute;
  z-index: -1;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.brand-panel::before {
  width: clamp(16rem, 34vw, 34rem);
  height: clamp(16rem, 34vw, 34rem);
  top: -14rem;
  right: -7rem;
}
.brand-panel::after {
  width: clamp(14rem, 28vw, 28rem);
  height: clamp(14rem, 28vw, 28rem);
  bottom: -13rem;
  left: -8rem;
}
.brand-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.fms-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  color: var(--blue-deep);
  font-size: clamp(1.7rem, 3.5vw, 2.7rem);
  font-weight: 900;
  letter-spacing: 0.18em;
  font-family: "Nerko One", "IBM Plex Sans Thai", sans-serif;
  font-weight: 400;
  letter-spacing: 0.1em;
}
.fms-brand img {
  width: clamp(3.2rem, 6vw, 4.8rem);
  border-radius: 24%;
  box-shadow: 0 0.7rem 1.3rem rgba(18, 55, 110, 0.18);
}
.institution-lockup {
  position: absolute;
  z-index: 4;
  top: clamp(1.2rem, 3vw, 3rem);
  right: clamp(1.4rem, 5vw, 6rem);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: clamp(0.25rem, 0.8vw, 0.55rem);
}
.auth-panel .institution-lockup {
  top: clamp(1rem, 2.5vh, 2rem);
  right: auto;
  left: clamp(0.75rem, 2vw, 1.5rem);
  align-items: flex-start;
}
.brand-panel .institution-lockup {
  top: clamp(1.25rem, 3vw, 3rem);
  right: clamp(2rem, 6vw, 5.5rem);
  left: auto;
  align-items: flex-end;
}
.brand-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: clamp(0.65rem, 1.1vw, 0.85rem);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-family: "Nerko One", "IBM Plex Sans Thai", sans-serif;
  letter-spacing: 0.1em;
  text-align: right;
}
.brand-copy {
  position: relative;
  z-index: 2;
  position: absolute;
  top: clamp(15rem, 28vh, 20rem);
  left: clamp(2rem, 5vw, 5rem);
  margin: 0;
  max-width: 34rem;
}
.kicker, .auth-overline, .auth-kicker {
  margin: 0 0 0.7rem;
  color: var(--orange);
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.brand-copy .kicker {
  color: var(--white);
  font-family: "Nerko One", "IBM Plex Sans Thai", sans-serif;
  font-size: clamp(0.95rem, 1.5vw, 1.2rem);
