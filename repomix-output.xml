.purchase-day.is-selected .purchase-day-dots small {
  color: #fff;
}
.purchase-day.is-today:not(.is-selected) {
  border-color: #5686d8;
  background: #fff;
  color: #174b9a;
  font-weight: 800;
}
.purchase-day-dots small {
  color: #075d68;
  font-weight: 700;
}
.purchase-dot {
  background: #087f87;
  box-shadow: 0 0 0 2px #087f8728;
