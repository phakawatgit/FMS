/* Responsive page sizing and title scale */
.duty-page {
  width: min(96vw,1600px);
  padding: clamp(18px,2.2vw,36px) 0 48px;
}
.duty-page-heading {
  padding: 0 8px clamp(14px,1.5vw,22px);
  margin-bottom: clamp(16px,1.7vw,26px);
}
.duty-page-heading h1 {
  font-size: clamp(27px,2.5vw,38px);
  line-height: 1.25;
}
.calendar-panel,.recent-panel {
  padding: clamp(18px,1.8vw,28px);
  border-radius: 18px;
  margin-bottom: clamp(16px,1.5vw,24px);
}
.calendar-title-row h2,.recent-heading h2 {
  font-size: clamp(23px,2vw,30px);
}
.week-row,.calendar-grid {
  gap: clamp(6px,.55vw,10px);
}
.week-row span {
  height: clamp(38px,3.2vw,48px);
  font-size: clamp(13px,.95vw,16px);
}
.calendar-grid {
  grid-auto-rows: minmax(clamp(54px,5vw,78px),1fr);
}
.calendar-cell,.calendar-blank {
  min-height: clamp(54px,5vw,78px);
}
.calendar-cell {
  font-size: clamp(13px,.95vw,16px);
  padding: 7px 9px;
}
.duty-tools {
  gap: clamp(14px,1.2vw,20px);
  margin-top: clamp(16px,1.3vw,22px);
}
.color-picker-card,.duty-form-card {
  padding: clamp(13px,1.2vw,20px);
}
.duty-form-card h3,.color-picker-head {
  font-size: clamp(16px,1.1vw,19px);
}
.duty-form-grid label {
  font-size: clamp(13px,.9vw,15px);
}
.duty-form-grid input {
  height: clamp(38px,2.8vw,46px);
  font-size: clamp(15px,1vw,17px);
}
.schedule-button {
  padding: 9px 18px;
  font-size: clamp(14px,.95vw,16px);
}
@media(max-width:760px) {
  .duty-page {
    width: calc(100% - 24px);
    padding-top: 18px;
  }
  .duty-page-heading h1 {
    font-size: clamp(24px,5vw,32px);
  }
  .calendar-panel,.recent-panel {
    padding: 14px;
  }
  .calendar-grid {
    grid-auto-rows: minmax(46px,1fr);
  }
  .calendar-cell,.calendar-blank {
