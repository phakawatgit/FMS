    width: calc(100% - 20px);
  }
}
.dispense-record {
  position: relative;
}
.dispense-icon.has-image {
  overflow: hidden;
  padding: 0;
  background: #f1f8f8;
}
.dispense-icon.has-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dispense-icon.is-placeholder {
  font-size: 25px;
}
.dispense-detail-open {
  position: absolute;
  right: 14px;
  bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 10px;
  border: 1px solid #c8e5e7;
  border-radius: 999px;
  background: #f6fcfc;
  color: #07517e;
  font: 600 10px Kanit,sans-serif;
  cursor: pointer;
  transition: background .15s ease,border-color .15s ease;
}
.dispense-detail-open span {
  font: 400 17px/9px Arial,sans-serif;
}
.dispense-detail-open:hover {
  border-color: #01b4ba;
  background: #e7f8f8;
}
@media(max-width:560px) {
  .dispense-record {
    display: flex;
    flex-wrap: wrap;
    padding: 11px 10px 12px;
  }
  .dispense-details {
    flex: 1 1 calc(100% - 44px);
    min-width: 0;
  }
  .dispense-record time {
    order: 3;
    position: static;
    max-width: none;
    margin: 0 0 0 43px;
    text-align: left;
  }
  .dispense-detail-open {
    position: static;
    order: 4;
    margin-left: auto;
    padding: 5px 8px;
  }
  .dispense-detail-open span {
    display: inline;
  }
}
.product-image-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg,#edf7f6,#e1efee);
  font-size: 26px;
}
html,body,body * {
  font-family: Kanit,sans-serif!important;
}
</file>

