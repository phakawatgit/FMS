}
.visit-detail-field strong {
  color: var(--theme-ink,#123b56);
  font-size: 14px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.empty-state {
  padding: 34px 18px;
  border: 1px dashed var(--theme-line,#c8e5e7);
  border-radius: 13px;
  background: #fff;
  color: var(--theme-muted,#648293);
  text-align: center;
  font-size: 14px;
}

/* Notification dropdown opened by the bell button. */
.notification-panel {
  position: fixed;
  z-index: 30;
  top: 76px;
  right: 16px;
  width: min(300px,calc(100vw - 32px));
  padding: 15px;
  border: 1px solid var(--theme-line,#c8e5e7);
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 12px 30px #10234b25;
  color: var(--theme-ink,#123b56);
}
.notification-panel[hidden] {
  display: none;
}
.notification-panel strong {
  font-size: 14px;
}
.notification-panel p {
  margin: 7px 0 0;
  color: var(--theme-muted,#648293);
  font-size: 12px;
}
.notification-panel button {
  float: right;
  border: 0;
  background: transparent;
  color: var(--theme-muted,#648293);
  font-size: 21px;
  cursor: pointer;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* Mobile layout: stack controls and allow cards to use the full viewport. */
@media(max-width:600px) {
