  width: 10px;
  height: 10px;
  border: 1px solid #17334a55;
  border-radius: 3px;
  cursor: help;
  outline-offset: 3px;
}
.calendar-duty-dot::after {
  content: attr(data-tooltip);
  position: absolute;
  z-index: 60;
  left: 50%;
  bottom: calc(100% + 8px);
  width: max-content;
  max-width: min(270px,75vw);
  padding: 9px 12px;
