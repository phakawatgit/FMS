<file path="Front-end/dashboard-refresh.css">
/* Calm, compact dashboard styling layered after the legacy dashboard rules. */
:root {
  --dash-ink: #183b50;
  --dash-muted: #718493;
  --dash-line: #e4edf0;
  --dash-accent: #087f8c;
  --dash-bg: #f5f8f9;
  --dash-shadow: 0 5px 20px rgba(25, 63, 78, .045);
}
html {
  font-size: 16px !important;
}
body {
  min-width: 320px;
  background: var(--dash-bg) !important;
  color: var(--dash-ink) !important;
  font-family: "IBM Plex Sans Thai", "Kanit", sans-serif !important;
}
.topbar {
  min-height: 64px !important;
  padding: .65rem clamp(1rem, 4vw, 3rem) !important;
  background: #fff !important;
  color: var(--dash-ink) !important;
  border-bottom: 1px solid var(--dash-line);
}
.brand {
  color: var(--dash-ink) !important;
  font-size: .95rem !important;
  gap: .55rem !important;
}
.brand img {
  width: 2rem !important;
  border-radius: .55rem !important;
}
.top-actions {
  gap: .5rem !important;
}
.top-actions .menu-link {
  background: #f2f7f8 !important;
  color: #476574 !important;
}
.top-actions .menu-link:hover {
  background: #e7f2f3 !important;
}
.topbar .icon-button {
  color: #526c79 !important;
}
.topbar .export, .top-actions .language-switcher {
  min-height: 2rem !important;
  padding: 0 .75rem !important;
  border: 1px solid var(--dash-line) !important;
  border-radius: .55rem !important;
  background: #fff !important;
  color: #365866 !important;
  font-size: .78rem !important;
}
.top-actions button.language-switcher {
  display: inline-flex!important;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  min-width: 5.2rem;
  cursor: pointer;
  font-family: Kanit,sans-serif;
}
.top-actions .language-switcher span {
  display: inline!important;
  visibility: visible!important;
  opacity: 1!important;
  color: inherit!important;
  font-size: inherit!important;
  font-weight: 600;
  line-height: 1;
}
.page {
  width: min(100% - 2rem, 1440px) !important;
  max-width: 1440px !important;
  min-height: calc(100vh - 64px) !important;
  margin: 0 auto !important;
  padding: 2rem 0 3rem !important;
}
.page h1 {
  margin: 0 0 1.25rem !important;
  color: #173e52 !important;
  font: 700 1.55rem/1.35 Kanit, sans-serif !important;
  letter-spacing: -.02em;
